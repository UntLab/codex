[Unit]
Description=BitVantage daily printable Google Drive snapshot
Documentation=file:/srv/stacks/bitvantage/app/BACKUP_RESTORE.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/bitvantage-google-snapshot.env
ExecStart=/usr/local/sbin/bitvantage-google-snapshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
